# kvm-center deploy-time secrets (docker-compose reads this file).
# Copy to .env (gitignored) and fill in real values. bootstrap.sh --deploy
# will generate a fresh .env with a strong password on first run if one
# doesn't exist, so most operators never touch this file directly.

# MongoDB root user (v5.1+). Used by both the mongo container on first
# init and by the kvm-center-server to build its connection string.
KVM_MONGO_USER=kvmcenter
KVM_MONGO_PASSWORD=change-me-to-a-long-random-string

# Optional — uncomment to override the defaults baked into docker-compose.

# HTTPS port the WebUI + agents reach the control plane on (default 8190).
# KVM_CENTER_HTTPS_PORT=8190

# Cluster DNS domain. Hypervisor leaf certs get a SAN at
# <host_id>.<KVM_CENTER_CLUSTER_DOMAIN> so peers can connect by FQDN
# without hostname-check failures during live migrations.
# KVM_CENTER_CLUSTER_DOMAIN=cluster.local

# Public URL the SPA hands out in install snippets. Set this once you
# have a real DNS name + TLS cert; otherwise the setup wizard captures
# whatever the operator types on first boot.
# KVM_CENTER_PUBLIC_URL=https://kvm-center.example.com:8190

# Image tag override — pinned via VERSION at the repo root by default.
# VERSION=v5.46.6
