# Builds both server and agent binaries, packages them with install scripts,
# and serves a download portal on port 8080 (python3 http.server).
FROM golang:1.22-alpine

RUN apk --no-cache add python3 tar

WORKDIR /src
COPY go.mod go.su[m] ./
COPY . .
# Single source of truth: kvm-tools embeds the same VERSION as the server.
RUN cp /src/server/VERSION /src/kvm-tools/VERSION
RUN go mod tidy

# Build server (linux/amd64 - runs in container)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/kvm-center-server ./server

# Build agent for common hypervisor targets
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/kvm-center-agent-amd64 ./agent

RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
    go build -ldflags="-s -w" -o /out/kvm-center-agent-arm64 ./agent

# Build kvm-tools guest daemon for Linux (amd64 + arm64) and Windows (amd64)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/kvm-tools-linux-amd64 ./kvm-tools

RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
    go build -ldflags="-s -w" -o /out/kvm-tools-linux-arm64 ./kvm-tools

RUN CGO_ENABLED=0 GOOS=windows GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/kvm-tools-windows-amd64.exe ./kvm-tools

# Bundle artifacts
RUN mkdir -p /dist && \
    cp /out/kvm-center-agent-amd64 /dist/ && \
    cp /out/kvm-center-agent-arm64 /dist/ && \
    cp /out/kvm-tools-linux-amd64 /dist/ && \
    cp /out/kvm-tools-linux-arm64 /dist/ && \
    cp /out/kvm-tools-windows-amd64.exe /dist/ && \
    cp /src/scripts/install-agent.sh /dist/ && \
    cp /src/scripts/update-agent.sh /dist/ && \
    cp /src/kvm-tools/install.sh /dist/install-kvm-tools.sh && \
    cp /src/kvm-tools/install.ps1 /dist/install-kvm-tools.ps1 && \
    chmod +x /dist/install-agent.sh /dist/update-agent.sh /dist/install-kvm-tools.sh && \
    (cp /src/migration-keys/kvm-migrator-key /dist/kvm-migrator-key 2>/dev/null || true) && \
    (cp /src/migration-keys/kvm-migrator-key.pub /dist/kvm-migrator-key.pub 2>/dev/null || true) && \
    cd /out && tar czf /dist/kvm-center-server.tar.gz kvm-center-server && \
    ln -s kvm-tools-linux-amd64 /dist/kvm-tools-amd64 && \
    ln -s kvm-tools-linux-arm64 /dist/kvm-tools-arm64

# Generate KVM Center styled download portal (matches the main web UI's
# productized theme — see docs/STYLE_GUIDE.md for the token reference).
# VERSION is sourced from the committed server/VERSION file so the portal
# badge stays in sync with the server binary without a build arg.
RUN VERSION=$(cat /src/server/VERSION | tr -d '[:space:]') && \
    cat > /dist/index.html << EOF_PORTAL
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>KVM Center Downloads</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#E3571E">
    <style>
        :root {
            --accent: #E3571E;
            --accent-hover: #FF8A3C;
            --accent-dim: #C04512;
            --accent-subtle: #2D1810;
            --bg: #0B0E13;
            --bg-input: #0D1117;
            --surface: #161B22;
            --surface-hover: #1C2128;
            --surface-active: #21262D;
            --border: #30363D;
            --border-subtle: #21262D;
            --text: #F0F6FC;
            --text-body: #C9D1D9;
            --text-muted: #8B949E;
            --text-faded: #6E7681;
            --success: #3FB950;
            --success-bg: #1E3D23;
        }
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
            max-width: 960px; margin: 0 auto; padding: 32px 24px 64px;
            background: var(--bg); color: var(--text-body);
            -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
            line-height: 1.55;
        }
        ::selection { background: #E3571E44; color: var(--text); }

        /* ── Header ── */
        .header {
            display: flex; align-items: center; gap: 14px;
            padding-bottom: 18px; margin-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }
        .header svg { flex-shrink: 0; filter: drop-shadow(0 0 8px rgba(227,87,30,0.25)); }
        .brand-text {
            display: flex; flex-direction: column; gap: 2px;
        }
        .brand-wordmark {
            display: inline-flex; align-items: baseline;
            font-size: 20px; font-weight: 700; letter-spacing: -0.01em;
        }
        .brand-primary { color: var(--text); }
        .brand-accent { color: var(--accent); margin-left: 2px; }
        .brand-sub {
            font-size: 11px; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.08em;
        }
        .version-badge {
            margin-left: auto;
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 12px; border-radius: 12px;
            background: var(--accent-subtle); color: var(--accent-hover);
            font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
            border: 1px solid var(--accent-dim);
        }
        .version-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

        /* ── Status banner ── */
        .status {
            display: flex; align-items: center; gap: 8px;
            padding: 10px 14px; border-radius: 4px; margin-bottom: 20px;
            font-size: 13px;
            background: var(--success-bg); color: var(--success);
            border: 1px solid rgba(63, 185, 80, 0.3);
        }
        .status::before { content: '●'; color: var(--success); }

        /* ── Cards ── */
        .package {
            background: var(--surface); padding: 24px;
            border: 1px solid var(--border); border-radius: 6px;
            margin-bottom: 20px;
        }
        h1 { margin: 0; display: none; }  /* brand block replaces h1 */
        h2 {
            color: var(--text); margin: 0 0 10px 0;
            font-size: 16px; font-weight: 600; letter-spacing: -0.01em;
        }
        h3 {
            color: var(--text); margin: 0 0 10px 0;
            font-size: 14px; font-weight: 600;
        }
        .package p {
            color: var(--text-body); margin: 0 0 14px 0;
            font-size: 13px;
        }

        /* ── Download buttons ── */
        .download-link {
            display: inline-flex; align-items: center; gap: 6px;
            background: linear-gradient(180deg, #F26419 0%, var(--accent) 100%);
            color: #fff;
            padding: 8px 14px; border: 1px solid var(--accent-dim); border-radius: 5px;
            text-decoration: none;
            font-weight: 500; font-size: 12px;
            margin: 4px 6px 4px 0;
            transition: background 0.15s, box-shadow 0.15s;
        }
        .download-link::before { content: '↓'; font-weight: 700; }
        .download-link:hover {
            background: linear-gradient(180deg, #FF7B3C 0%, #F26419 100%);
        }
        .download-link.secondary {
            background: var(--surface-active); color: var(--text-body);
            border-color: var(--border);
        }
        .download-link.secondary::before { content: '↓'; color: var(--text-muted); }
        .download-link.secondary:hover {
            background: var(--border); color: var(--text);
        }

        /* ── Code / snippets ── */
        code {
            background: var(--bg-input); color: var(--accent-hover);
            padding: 2px 6px; border-radius: 3px;
            font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
            font-size: 12px;
            border: 1px solid var(--border-subtle);
        }
        pre {
            background: var(--bg-input); color: var(--text);
            padding: 14px 16px; border: 1px solid var(--border);
            border-radius: 5px; overflow-x: auto;
            font-size: 12px; line-height: 1.55;
            font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
            margin: 8px 0;
        }

        /* ── Instructions panel (accent-bordered) ── */
        .instructions {
            background: var(--surface); padding: 24px;
            border: 1px solid var(--border); border-left: 3px solid var(--accent);
            border-radius: 6px; margin-bottom: 20px;
        }

        /* ── Meta / sub-section headings ── */
        .meta { color: var(--text-muted); font-size: 12px; margin-bottom: 4px; }
        .meta strong { color: var(--text); font-weight: 600; }
        .subsection { margin-top: 18px; }
        .subsection h4 {
            color: var(--text-faded); margin: 0 0 8px 0; font-size: 10px;
            font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em;
        }

        /* ── Lists ── */
        ul.file-list {
            margin: 0; padding-left: 0; list-style: none;
        }
        ul.file-list li {
            padding: 8px 0; border-bottom: 1px solid var(--border-subtle);
            font-size: 13px;
        }
        ul.file-list li:last-child { border-bottom: none; }
        p { line-height: 1.55; }

        /* ── Responsive ── */
        @media (max-width: 640px) {
            body { padding: 20px 12px 40px; }
            .header { flex-wrap: wrap; }
            .version-badge { margin-left: 0; margin-top: 8px; }
            .download-link { width: 100%; justify-content: center; margin-right: 0; }
        }
    </style>
</head>
<body>
    <div class="header">
        <svg width="40" height="40" viewBox="0 0 32 32" fill="none" aria-label="KVM Center">
            <defs>
                <linearGradient id="logo-accent" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#FF8A3C"/>
                    <stop offset="100%" stop-color="#E3571E"/>
                </linearGradient>
            </defs>
            <path d="M16 3 L27 10 L27 22 L16 29 L5 22 L5 10 Z"
                  fill="none" stroke="url(#logo-accent)" stroke-width="2" stroke-linejoin="round"/>
            <rect x="10" y="11" width="12" height="3" rx="0.5" fill="url(#logo-accent)"/>
            <rect x="10" y="15" width="9"  height="3" rx="0.5" fill="#E3571E" opacity="0.7"/>
            <rect x="10" y="19" width="6"  height="3" rx="0.5" fill="#E3571E" opacity="0.45"/>
        </svg>
        <div class="brand-text">
            <div class="brand-wordmark"><span class="brand-primary">kvm</span><span class="brand-accent">center</span></div>
            <div class="brand-sub">Build Artefacts &amp; Installers</div>
        </div>
        <span class="version-badge">${VERSION}</span>
    </div>

    <div class="status">Build complete — all packages ready for download.</div>

    <!-- Hypervisor Agent -->
    <div class="package">
        <h2>Hypervisor Agent</h2>
        <p>Install on each KVM hypervisor to onboard it to the kvm-center fleet.
        Collects host telemetry, manages VMs, routes VNC console sessions, and
        handles live + offline migrations via the kvm-migrator user.</p>

        <p class="meta"><strong>Binaries:</strong></p>
        <a href="/kvm-center-agent-amd64" class="download-link">kvm-center-agent-amd64</a>
        <a href="/kvm-center-agent-arm64" class="download-link secondary">kvm-center-agent-arm64</a>
        <a href="/install-agent.sh" class="download-link secondary">install-agent.sh</a>

        <div class="subsection">
            <h4>Quick Install (RHEL / Rocky / Ubuntu)</h4>
            <p>Replace <code>YOUR_HOST_IP</code> with this server's IP (e.g. 10.10.100.8) and <code>SERVER_IP</code> with the kvm-center server IP.</p>
            <pre>curl -fsSL http://YOUR_HOST_IP:8097/kvm-center-agent-amd64 -o /tmp/kvm-center-agent-amd64
curl -fsSL http://YOUR_HOST_IP:8097/install-agent.sh     -o /tmp/install-agent.sh
chmod +x /tmp/install-agent.sh /tmp/kvm-center-agent-amd64
sudo /tmp/install-agent.sh --server http://SERVER_IP:8090</pre>
        </div>
    </div>

    <!-- KVM Tools (Guest Daemon) -->
    <div class="package">
        <h2>KVM Tools (Guest Daemon)</h2>
        <p>Install inside a guest VM for guest OS name, hostname, IP addresses,
        kernel version, and per-mountpoint filesystem usage. Once installed,
        the VM's detail page shows <strong>KVM Tools: running</strong>.</p>

        <p class="meta"><strong>Binaries:</strong></p>
        <a href="/kvm-tools-linux-amd64" class="download-link">Linux x86_64</a>
        <a href="/kvm-tools-linux-arm64" class="download-link secondary">Linux ARM64</a>
        <a href="/kvm-tools-windows-amd64.exe" class="download-link secondary">Windows x86_64 (.exe)</a>
        <a href="/install-kvm-tools.sh" class="download-link secondary">install-kvm-tools.sh</a>
        <a href="/install-kvm-tools.ps1" class="download-link secondary">install-kvm-tools.ps1</a>

        <div class="subsection">
            <h4>Linux Install (RHEL / Rocky / Ubuntu / Debian)</h4>
            <pre>curl -fsSL http://YOUR_HOST_IP:8097/kvm-tools-linux-amd64 -o /tmp/kvm-tools-amd64
curl -fsSL http://YOUR_HOST_IP:8097/install-kvm-tools.sh  -o /tmp/install-kvm-tools.sh
chmod +x /tmp/install-kvm-tools.sh /tmp/kvm-tools-amd64
sudo /tmp/install-kvm-tools.sh --server http://SERVER_IP:8090</pre>
        </div>

        <div class="subsection">
            <h4>Windows Install (PowerShell, run as Administrator)</h4>
            <pre>\$portal = 'http://YOUR_HOST_IP:8097'
\$server = 'http://SERVER_IP:8090'
\$tmp = Join-Path \$env:TEMP 'kvm-tools-install'
New-Item -ItemType Directory -Force -Path \$tmp | Out-Null
Invoke-WebRequest "\$portal/kvm-tools-windows-amd64.exe" -OutFile "\$tmp\\kvm-tools.exe" -UseBasicParsing
Invoke-WebRequest "\$portal/install-kvm-tools.ps1"       -OutFile "\$tmp\\install-kvm-tools.ps1" -UseBasicParsing
Set-Location \$tmp
.\\install-kvm-tools.ps1 -Server \$server</pre>
        </div>
    </div>

    <!-- Server -->
    <div class="package">
        <h2>Server (Control Plane)</h2>
        <p>The kvm-center server is normally deployed via Docker Compose.
        This tarball contains the standalone binary for bare-metal installs.</p>
        <a href="/kvm-center-server.tar.gz" class="download-link">kvm-center-server.tar.gz</a>
    </div>

    <!-- Package Contents -->
    <div class="package">
        <h3>Package Contents</h3>
        <ul class="file-list">
            <li><code>kvm-center-agent-amd64</code> / <code>-arm64</code> - Hypervisor agent (Go static binary, ~7 MB)</li>
            <li><code>install-agent.sh</code> - Systemd installer; creates the kvm-migrator user and installs the shared migration SSH keypair</li>
            <li><code>kvm-tools-linux-amd64</code> / <code>-arm64</code> / <code>-windows-amd64.exe</code> - Guest telemetry daemon (~5 MB)</li>
            <li><code>install-kvm-tools.sh</code> - Linux systemd installer for the guest daemon</li>
            <li><code>install-kvm-tools.ps1</code> - Windows PowerShell installer (registers as a scheduled task running as SYSTEM)</li>
            <li><code>kvm-migrator-key</code> / <code>-key.pub</code> - Shared ed25519 keypair trusted across hypervisors for live / offline migrations</li>
            <li><code>kvm-center-server.tar.gz</code> - Control plane binary (bare-metal only; use docker-compose for production)</li>
        </ul>
    </div>

    <!-- Verification -->
    <div class="instructions">
        <h3>Verifying a Successful Install</h3>
        <p>After running the installer the new agent or kvm-tools should appear
        in the kvm-center inventory within 30 seconds:</p>
        <pre># 1. Server liveness
curl -s http://SERVER_IP:8090/health

# 2. List hosts the server has registered
curl -s http://SERVER_IP:8090/api/hosts | python3 -m json.tool

# 3. List all VMs (look for guest_agent: true after kvm-tools install)
curl -s http://SERVER_IP:8090/api/vms | python3 -m json.tool</pre>
        <p style="font-size: 0.9em; color: #666; margin-top: 12px;">
            Or just open the web UI at <code>http://SERVER_IP:8096</code> - new hypervisors appear on the Dashboard and new VMs with tools flip to a green
            <strong>KVM Tools: running</strong> pill on their detail page.
        </p>
    </div>
</body>
</html>
EOF_PORTAL

WORKDIR /dist
EXPOSE 8080
CMD ["python3", "-m", "http.server", "8080"]
