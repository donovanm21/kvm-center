      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "host_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Host"
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu_usage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.displayMode",
                "value": "gradient-gauge"
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "displayName",
                "value": "CPU %"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mem_usage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.displayMode",
                "value": "gradient-gauge"
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "displayName",
                "value": "Memory %"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mem_free_mb"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "displayName",
                "value": "Free RAM"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mem_total_mb"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "displayName",
                "value": "Total RAM"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vm_count"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "displayName",
                "value": "VMs"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Host",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\")\n  |> last()\n  |> pivot(rowKey: [\"host_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"host_id\", \"status\", \"cpu_usage\", \"mem_usage\", \"mem_free_mb\", \"mem_total_mb\", \"vm_count\"])\n  |> group()\n  |> sort(columns: [\"host_id\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "host_id": 0,
              "status": 1,
              "cpu_usage": 2,
              "mem_usage": 3,
              "mem_free_mb": 4,
              "mem_total_mb": 5,
              "vm_count": 6
            }
          }
        }
      ]
