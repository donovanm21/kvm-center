{
  "__inputs": [
    {
      "name": "DS_INFLUX",
      "label": "InfluxDB",
      "description": "InfluxDB v2 datasource pointing at the bucket kvm-center writes to.",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "title": "kvm-center Fleet",
  "uid": "kvm-center",
  "schemaVersion": 39,
  "version": 3,
  "timezone": "",
  "editable": true,
  "tags": [
    "kvm-center"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "kvm-center",
        "current": {
          "text": "kvm-center",
          "value": "kvm-center"
        },
        "description": "InfluxDB v2 bucket the server writes to (Settings \u2192 Metrics)."
      },
      {
        "name": "prefix",
        "label": "Measurement prefix",
        "type": "textbox",
        "query": "kvm_center_",
        "current": {
          "text": "kvm_center_",
          "value": "kvm_center_"
        },
        "description": "Match Settings \u2192 Metrics \u2192 Measurement prefix. Leave trailing underscore."
      }
    ]
  },
  "panels": [
    {
      "id": 200,
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:14px;padding:8px 4px;\"><img src=\"data:image/svg+xml;base64,\" width=\"48\" height=\"48\" alt=\"kvm-center\" style=\"flex-shrink:0;\"/><img src=\"data:image/svg+xml;base64,\" height=\"32\" alt=\"kvm center\" style=\"flex-shrink:0;\"/><div style=\"margin-left:auto;color:#8b9098;font-size:12px;\">Fleet-wide metrics from every enrolled hypervisor. Refresh every 30s.</div></div>"
      },
      "transparent": true
    },
    {
      "type": "row",
      "id": 100,
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Running VMs",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "displayName": " "
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"state_code\")\n  |> last()\n  |> filter(fn: (r) => r._value == 1)\n  |> group()\n  |> count()"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts Online",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "displayName": " "
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"vm_count\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> count()"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Fleet CPU (avg)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "displayName": " ",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 65
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"cpu_usage\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> mean()"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Fleet RAM (avg)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "displayName": " ",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_usage\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> mean()"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fleet RAM Free",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "displayName": " "
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_free_mb\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> sum()"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fleet RAM Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "displayName": " "
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_total_mb\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> sum()"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Host trends",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Host CPU %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "displayName": "${__field.labels.host_id}"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"cpu_usage\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"host_id\"])"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Host Memory %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "displayName": "${__field.labels.host_id}"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_usage\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"host_id\"])"
        }
