{
  "__inputs": [
    {
      "name": "DS_INFLUX",
      "label": "InfluxDB",
      "description": "InfluxDB v2 datasource pointing at the bucket kvm-center writes to.",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "title": "kvm-center Fleet",
  "uid": "kvm-center",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "",
  "editable": true,
  "tags": ["kvm-center"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "kvm-center",
        "current": { "text": "kvm-center", "value": "kvm-center" },
        "description": "InfluxDB v2 bucket the server writes to (Settings → Metrics)."
      },
      {
        "name": "prefix",
        "label": "Measurement prefix",
        "type": "textbox",
        "query": "kvm_center_",
        "current": { "text": "kvm_center_", "value": "kvm_center_" },
        "description": "Match Settings → Metrics → Measurement prefix. Leave trailing underscore."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Running VMs",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"state_code\")\n  |> last()\n  |> filter(fn: (r) => r._value == 1)\n  |> group()\n  |> count()"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts Online",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"vm_count\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> count()"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Fleet CPU (avg)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 65 },
            { "color": "red", "value": 85 }
          ]}
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"cpu_usage\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> mean()"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Fleet RAM (avg)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 75 },
            { "color": "red", "value": 90 }
          ]}
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_usage\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> mean()"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fleet RAM Free",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_free_mb\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> sum()"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fleet RAM Total",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_total_mb\" and r.status == \"online\")\n  |> last()\n  |> group()\n  |> sum()"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Host trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Host CPU %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "displayName": "${__field.labels.host_id}"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"cpu_usage\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"host_id\"])"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Host Memory %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "displayName": "${__field.labels.host_id}"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"mem_usage\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"host_id\"])"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Fleet breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Hosts",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cpu_usage" },    "properties": [{ "id": "unit", "value": "percent" }, { "id": "custom.displayMode", "value": "gradient-gauge" }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 }, { "id": "displayName", "value": "CPU %" }] },
          { "matcher": { "id": "byName", "options": "mem_usage" },    "properties": [{ "id": "unit", "value": "percent" }, { "id": "custom.displayMode", "value": "gradient-gauge" }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 }, { "id": "displayName", "value": "Memory %" }] },
          { "matcher": { "id": "byName", "options": "mem_free_mb" },  "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "displayName", "value": "Free RAM" }] },
          { "matcher": { "id": "byName", "options": "mem_total_mb" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "displayName", "value": "Total RAM" }] },
          { "matcher": { "id": "byName", "options": "vm_count" },     "properties": [{ "id": "displayName", "value": "VMs" }] },
          { "matcher": { "id": "byName", "options": "host_id" },      "properties": [{ "id": "displayName", "value": "Host" }] },
          { "matcher": { "id": "byName", "options": "status" },       "properties": [{ "id": "displayName", "value": "Status" }] }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\")\n  |> last()\n  |> pivot(rowKey: [\"host_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"host_id\", \"status\", \"cpu_usage\", \"mem_usage\", \"mem_free_mb\", \"mem_total_mb\", \"vm_count\"])\n  |> sort(columns: [\"host_id\"])"
        }
      ]
    },
    {
      "id": 21,
      "type": "piechart",
      "title": "VM state breakdown",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "running" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "paused" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "stopped" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } }] },
          { "matcher": { "id": "byName", "options": "crashed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "right", "values": ["value"] }, "pieType": "donut" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"state_code\")\n  |> last()\n  |> group(columns: [\"state\"])\n  |> count()\n  |> keep(columns: [\"state\", \"_value\"])\n  |> rename(columns: {state: \"_field\"})"
        }
      ]
    },
    {
      "id": 22,
      "type": "bargauge",
      "title": "VMs per host",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}host\" and r._field == \"vm_count\")\n  |> last()\n  |> keep(columns: [\"_value\", \"host_id\"])\n  |> rename(columns: {host_id: \"_field\"})"
        }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "Top VMs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Top CPU consumers",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "fillOpacity": 10, "lineWidth": 1.5 },
          "displayName": "${__field.labels.vm_name}"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } },
      "targets": [
        {
          "refId": "A",
          "query": "top10 = from(bucket: \"${bucket}\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"cpu_usage\")\n  |> mean()\n  |> group()\n  |> top(n: 10, columns: [\"_value\"])\n  |> keep(columns: [\"vm_uuid\"])\n\nfrom(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"cpu_usage\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"vm_name\", \"vm_uuid\", \"host_id\"])\n  |> join(tables: {t: top10}, on: [\"vm_uuid\"])"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Top memory consumers",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "fillOpacity": 10, "lineWidth": 1.5 },
          "displayName": "${__field.labels.vm_name}"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } },
      "targets": [
        {
          "refId": "A",
          "query": "top10 = from(bucket: \"${bucket}\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"mem_usage_mb\")\n  |> mean()\n  |> group()\n  |> top(n: 10, columns: [\"_value\"])\n  |> keep(columns: [\"vm_uuid\"])\n\nfrom(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"mem_usage_mb\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"vm_name\", \"vm_uuid\", \"host_id\"])\n  |> join(tables: {t: top10}, on: [\"vm_uuid\"])"
        }
      ]
    },
    {
      "type": "row",
      "id": 104,
      "title": "Snapshots",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }
    },
    {
      "id": 40,
      "type": "stat",
      "title": "Snapshots (fleet)",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 34 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"snapshot_count\")\n  |> last()\n  |> group()\n  |> sum()"
        }
      ]
    },
    {
      "id": 41,
      "type": "bargauge",
      "title": "Snapshots per host",
      "gridPos": { "h": 6, "w": 10, "x": 4, "y": 34 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } } },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"snapshot_count\")\n  |> last()\n  |> group(columns: [\"host_id\"])\n  |> sum()\n  |> keep(columns: [\"_value\", \"host_id\"])\n  |> rename(columns: {host_id: \"_field\"})"
        }
      ]
    },
    {
      "id": 42,
      "type": "table",
      "title": "VMs with most snapshots",
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 34 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUX}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "vm_name" },        "properties": [{ "id": "displayName", "value": "VM" }] },
          { "matcher": { "id": "byName", "options": "host_id" },        "properties": [{ "id": "displayName", "value": "Host" }] },
          { "matcher": { "id": "byName", "options": "_value" },         "properties": [{ "id": "displayName", "value": "Snapshots" }, { "id": "custom.displayMode", "value": "gradient-gauge" }] }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"snapshot_count\")\n  |> last()\n  |> filter(fn: (r) => r._value > 0)\n  |> keep(columns: [\"vm_name\", \"host_id\", \"_value\"])\n  |> group()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 15)"
        }
      ]
    }
  ]
}
