      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"${prefix}vm\" and r._field == \"state_code\")\n  |> last()\n  |> group(columns: [\"state\"])\n  |> count()"
