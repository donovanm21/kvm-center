# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file for kvm-center.
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

# Go uses tabs (gofmt is authoritative).
[*.go]
indent_style = tab

# Web / config files use 2-space indentation.
[*.{ts,tsx,js,jsx,json,css,html,yml,yaml,md}]
indent_style = space
indent_size = 2

# Makefiles require tabs.
[Makefile]
indent_style = tab

# Markdown: preserve trailing whitespace (hard line breaks).
[*.md]
trim_trailing_whitespace = false
